# Bitplaza — environment
# Copy to .env.local and fill in. Nothing here has a working default; the app is
# built to run with any of these missing rather than to fail loudly, so check
# this file first when a feature appears to do nothing.

# ── Site ───────────────────────────────────────────────────────────────────
# Canonical origin. Used for metadata, the canonical URL, sitemap and the
# referral links in outgoing email. Must include the protocol, no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (Neon) ────────────────────────────────────────────────────────
# Use the POOLED connection string for the app. Prisma opens a connection per
# serverless invocation, and the direct string will exhaust Postgres under any
# real traffic.
DATABASE_URL=

# The DIRECT (non-pooled) string. Migrations only — they cannot run through a
# transaction pooler.
DIRECT_URL=

# ── Email (Resend) ─────────────────────────────────────────────────────────
# The sending domain needs SPF, DKIM and DMARC records verified before any mail
# is delivered reliably. Start that early; DNS propagation and reputation
# warm-up are on the critical path, not a last-minute step.
RESEND_API_KEY=
EMAIL_FROM="Bitplaza <hello@bitplaza.com>"
EMAIL_REPLY_TO=

# ── Analytics (PostHog) ────────────────────────────────────────────────────
# Leave blank in development and previews — with no key, analytics is inert and
# no events are sent anywhere. See src/lib/analytics/client.ts for the
# deliberately restrictive configuration.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── Bot defence (Cloudflare Turnstile) ─────────────────────────────────────
# Chosen over reCAPTCHA because it sets no cookies, which is what /data claims.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Admin ──────────────────────────────────────────────────────────────────
# Bearer token for the CSV export endpoint. Generate with:
#   openssl rand -base64 32
# There is no login; this single token is the entire gate, so treat it as a
# password and rotate it if it is ever pasted anywhere shared.
ADMIN_EXPORT_TOKEN=
